# CI image: builds the MCP tool, packs the .cgp archive, and exports it.
# Used by the Publish workflow to attach the archive to a GitHub Release.
ARG GO_VERSION=1.26
FROM golang:${GO_VERSION}-alpine

ENV PATH="/root/go/bin:${PATH}"

WORKDIR /src
COPY . .

RUN apk add --no-cache jq make \
    && go install github.com/CognitiveOS-Project/cpm/cmd/cpm@v1.0.9-alpha \
    && make pack \
    && mkdir -p /out \
    && cp *.cgp /out/ \
    && cpm info --json > /out/pkg.json

FROM scratch
COPY --from=0 /out /out
